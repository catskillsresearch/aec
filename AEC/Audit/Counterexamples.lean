module

public import AEC.Audit.TinyAEC
public import AEC.Section10.Results
public import AEC.Section11.Results
public import AEC.Section9.Results
public import AEC.Section12.Results
public import AEC.Section14.Results

@[expose] public section

/-!
# Statement audit: counterexamples to formal statements as originally written

* `proposition_10_2_unconditional_false`: "every AEC has `MinimalData` with `ℵ₀ ≤ λ₀`" fails
  for `tinyAEC` (all its models have at most one element). `proposition_10_2` now carries the
  paper's standing hypothesis `CategoricalUnbounded K`.
* `lemma_11_2_inactive_vertex_false`: "an inactive vertex equals the vertex of its largest
  active subset" fails for an arbitrary `GeometricSystem` (vertices are not forced to be
  generated by their pieces). The clause was dropped from `lemma_11_2`.
* `lemma_10_8_statement_defect`: the original conclusion of `lemma_10_8` ignored `c`/`β`; at
  the base pointed model it demands a new realization outside `M₀`, which cannot exist, so the
  original statement is false whenever some pointed model has a new realization.
* `theorem_9_8_arbitrary_false`: exact boundary lifting fails for arbitrary `FaceFamily`s
  (with `n = 0` there are no proper faces, so any two top objects have a boundary iso).
* `theorem_9_3_unconditional_false`: with no members (`emptyAEC`) there is no term template,
  hence no working scheme on a nonempty shape.
* `theorem_11_9_arbitrary_false`, `theorem_12_2_arbitrary_false`,
  `theorem_14_3_arbitrary_false`: on `0` axes a geometric system is one model with an
  unconstrained `level`; an empty and a one-point system have equinumerous (empty) pieces and a
  vacuous prescribed boundary iso, but no isomorphism of tops.
-/

namespace AEC
namespace Audit

universe u

open FirstOrder Cardinal

set_option linter.unusedVariables false

theorem tinyAEC_card_le_one (M : Model tinyAEC.{u}.τ) (hM : tinyAEC.Mem M) : Model.card M ≤ 1 :=
  Cardinal.le_one_iff_subsingleton.mpr hM

/-- The unconditional form of Proposition 10.2 is false. -/
theorem proposition_10_2_unconditional_false :
    ¬ ∀ K : AbstractElementaryClass.{u}, ∃ D : MinimalData K, aleph0 ≤ D.lam0 := by
  intro h
  obtain ⟨D, hD⟩ := h tinyAEC.{u}
  have h1 : D.lam0 ≤ 1 := D.card_eq ▸ tinyAEC_card_le_one D.M0 D.inM0
  exact absurd (hD.trans h1) (not_le.mpr one_lt_aleph0)

/-- One axis, only `∅` active. -/
def L1 : Set (Finset (Fin 1)) := extendFamily 0 ({∅} : Set (Finset (Fin 0))) ∅

theorem L1_admissible : Admissible 1 L1 :=
  Admissible.step Admissible.nil (Set.empty_subset _) (fun _ _ h => h.elim)

theorem mem_L1 {t : Finset (Fin 1)} (ht : t ∈ L1) : t = ∅ := by
  rcases ht with ⟨s, hs, rfl⟩ | ⟨s, hs, -⟩
  · rw [Set.mem_singleton_iff.mp hs]; rfl
  · exact hs.elim

/-- Vertex `s` has one point when `s` is nonempty and none otherwise. -/
def vtx (s : Finset (Fin 1)) : Model tinyAEC.{u}.τ :=
  ⟨{_x : PUnit.{u + 1} // s.Nonempty}, eStr _⟩

instance (s : Finset (Fin 1)) : Subsingleton (vtx.{u} s).carrier :=
  ⟨fun _ _ => Subtype.ext (Subsingleton.elim _ _)⟩

def vle {s t : Finset (Fin 1)} (h : s ⊆ t) :
    Language.Embedding tinyAEC.{u}.τ (vtx.{u} s).carrier (vtx.{u} t).carrier :=
  @emb _ _ (vtx.{u} s).str (vtx.{u} t).str
    (fun x => ⟨x.1, x.2.mono h⟩) (fun _ _ _ => Subsingleton.elim _ _)

/-- A geometric system whose inactive top vertex is strictly bigger than the vertex of its
largest active subset `∅`. -/
noncomputable def X1 : GeometricSystem tinyAEC.{u} 1 L1 where
  admissible := L1_admissible
  level := 0
  vertex := vtx
  inK _ := (inferInstance : Subsingleton _)
  le h := vle h
  le_strong _ := ⟨(inferInstance : Subsingleton _), (inferInstance : Subsingleton _)⟩
  le_refl _ := by ext x; exact Subsingleton.elim _ _
  le_trans _ _ := by ext x; exact Subsingleton.elim _ _
  indep _ _ := True
  inP t := {x | InClosure (fun _ => True)
    {y | ∃ s, ∃ hs : s ∈ L1, ∃ hst : s ⊆ t, ∃ z, z ∈ (∅ : Set (vtx.{u} s).carrier) ∧ vle hst z = y} x}
  piece _ _ := ∅
  pieceRank _ _ := 0
  piece_card _ _ := by simp
  span _ := rfl

/-- The fourth clause of the original Lemma 11.2 is false for an arbitrary geometric system. -/
theorem lemma_11_2_inactive_vertex_false :
    ¬ ∀ (K : AbstractElementaryClass.{u}) (X : GeometricSystem K 1 L1) (t u : Finset (Fin 1)),
      IsLargestActive L1 t u → ¬ t ∈ L1 →
      ∃ h : u ⊆ t, Function.Bijective (X.le h) := by
  intro H
  have hlarg : IsLargestActive L1 Finset.univ ∅ :=
    ⟨Or.inl ⟨∅, rfl, rfl⟩, Finset.empty_subset _, fun s hs _ => (mem_L1 hs).le⟩
  have hnot : ¬ (Finset.univ : Finset (Fin 1)) ∈ L1 := fun h => by
    have := mem_L1 h
    simp at this
  obtain ⟨h, hb⟩ := H tinyAEC.{u} X1 Finset.univ ∅ hlarg hnot
  obtain ⟨x, -⟩ := hb.2 (⟨PUnit.unit, Finset.univ_nonempty⟩ : (vtx.{u} Finset.univ).carrier)
  exact Finset.not_nonempty_empty x.2

/-- The original Lean statement of Lemma 10.8 is false whenever some pointed model carries a
new realization: at the base pointed model `M₀` the conclusion asks for a realization outside
the image of the identity. -/
theorem lemma_10_8_statement_defect (K : AbstractElementaryClass.{u}) (D : MinimalData K)
    (A : PointedModel K D) (a : A.M.carrier) (hr : D.realizes A.M A.copy a)
    (hnew : ∀ x, A.copy x ≠ a) :
    ¬ ∃ β : Cardinal.{u}, aleph0 ≤ β ∧
      ∀ (A : PointedModel K D) (a : A.M.carrier),
        D.realizes A.M A.copy a → (∀ x, A.copy x ≠ a) →
        ∃ (ι : Type u) (c : ι → A.M.carrier), #ι ≤ β ∧
          ∀ (B : PointedModel K D), D.Delta B.M B.copy →
            ∃ b : B.M.carrier, D.realizes B.M B.copy b ∧ ∀ x, B.copy x ≠ b := by
  rintro ⟨β, -, h⟩
  obtain ⟨ι, _c, -, hB⟩ := h A a hr hnew
  obtain ⟨b, -, hb⟩ := hB ⟨D.M0, Language.Embedding.refl _ _, K.strong_refl _ D.inM0,
    D.Delta_base⟩ D.Delta_base
  exact hb b rfl

/-- The constant face family on `0` axes whose single object has a point iff `b`. -/
def constFace (b : Prop) : FaceFamily tinyAEC.{u} 0 where
  obj _ := ⟨{_x : PUnit.{u + 1} // b}, eStr _⟩
  inK _ := (⟨fun _ _ => Subtype.ext (Subsingleton.elim _ _)⟩ : Subsingleton {_x : PUnit.{u + 1} // b})
  incl _ := @emb _ _ (eStr _) (eStr _) id Function.injective_id
  incl_strong _ := ⟨⟨fun _ _ => Subtype.ext (Subsingleton.elim _ _)⟩,
    ⟨fun _ _ => Subtype.ext (Subsingleton.elim _ _)⟩⟩
  incl_refl _ := rfl
  incl_trans _ _ := rfl

theorem not_isProper_fin0 (s : Set (Fin 0)) : ¬ IsProper s :=
  fun hs => hs (Set.eq_univ_of_forall fun i => i.elim0)

/-- On `0` axes every pair of face families has a (vacuous) boundary isomorphism. -/
def boundary0 (J Kf : FaceFamily tinyAEC.{u} 0) : BoundaryMap tinyAEC.{u} J Kf where
  onFace hs := absurd hs (not_isProper_fin0 _)
  onFace_strong hs := absurd hs (not_isProper_fin0 _)
  compat hs := absurd hs (not_isProper_fin0 _)

/-- Theorem 9.8 as stated (for arbitrary face families) is false. -/
theorem theorem_9_8_arbitrary_false :
    ¬ ∀ (K : AbstractElementaryClass.{u}) (n : ℕ)
      (J Kf : FaceFamily K n) (h : BoundaryMap K J Kf), IsBoundaryIso h →
      ∃ e : (J.obj Set.univ).carrier ≃[K.τ] (Kf.obj Set.univ).carrier,
        K.Strong e.toEmbedding ∧
        ∀ (s : Set (Fin n)) (hs : IsProper s) (x : (J.obj s).carrier),
          e (J.incl (Set.subset_univ s) x) = Kf.incl (Set.subset_univ s) (h.onFace hs x) := by
  intro H
  obtain ⟨e, -⟩ := H tinyAEC.{u} 0 (constFace False) (constFace True)
    (boundary0 _ _) (fun hs => absurd hs (not_isProper_fin0 _))
  exact (e.symm (⟨PUnit.unit, trivial⟩ : {_x : PUnit.{u + 1} // True})).2

/-- Theorem 9.3 without hypotheses is false: the empty AEC has no working scheme on a
nonempty shape (a term template would need a member of `K`). -/
theorem theorem_9_3_unconditional_false :
    ¬ ∀ (K : AbstractElementaryClass.{u}) (n : ℕ),
      ∃ S : SystemShape.{u}, ∃ W : WorkingScheme K S, IsWorkingPackage W ∧
        #S.Vertex = (n + 1 : Cardinal.{u}) ∧ ∀ μ ∈ W.eligible, IsWorkingLevel μ := by
  intro H
  obtain ⟨S, W, -, hcard, -⟩ := H emptyAEC.{u} 0
  have : Nonempty S.Vertex := by
    rw [← Cardinal.mk_ne_zero_iff, hcard]
    simp
  obtain ⟨v⟩ := this
  exact (W.template.present PUnit.{u + 1}).inK v

/-- On `0` axes the only label is `∅`. -/
def L0 : Set (Finset (Fin 0)) := {∅}

theorem finset_fin0_eq_univ (s : Finset (Fin 0)) : s = Finset.univ :=
  Subsingleton.elim _ _

/-- The geometric system on `0` axes whose vertex has a point iff `b`, at level `μ`. -/
noncomputable def GS0 (b : Prop) (μ : Cardinal.{u}) : GeometricSystem tinyAEC.{u} 0 L0 where
  admissible := Admissible.nil
  level := μ
  vertex _ := ⟨{_x : PUnit.{u + 1} // b}, eStr _⟩
  inK _ := (⟨fun _ _ => Subtype.ext (Subsingleton.elim _ _)⟩ : Subsingleton {_x : PUnit.{u + 1} // b})
  le _ := @emb _ _ (eStr _) (eStr _) id Function.injective_id
  le_strong _ := ⟨⟨fun _ _ => Subtype.ext (Subsingleton.elim _ _)⟩,
    ⟨fun _ _ => Subtype.ext (Subsingleton.elim _ _)⟩⟩
  le_refl _ := rfl
  le_trans _ _ := rfl
  indep _ _ := True
  inP t := {x | InClosure (fun _ => True)
    {y | ∃ s, ∃ hs : s ∈ L0, ∃ hst : s ⊆ t, ∃ z,
      z ∈ (∅ : Set {_x : PUnit.{u + 1} // b}) ∧ id z = y} x}
  piece _ _ := ∅
  pieceRank _ _ := 0
  piece_card _ _ := by simp
  span _ := rfl

/-- On `0` axes there are no proper faces, so every pair of systems has a prescribed boundary
isomorphism. -/
def pbi0 (X Y : GeometricSystem tinyAEC.{u} 0 L0) : PrescribedBoundaryIso tinyAEC.{u} X Y where
  onFace s hs := absurd (finset_fin0_eq_univ s) hs
  onFace_strong s hs := absurd (finset_fin0_eq_univ s) hs
  comm s _ hs := absurd (finset_fin0_eq_univ s) hs

theorem no_top_iso (μ ν : Cardinal.{u})
    (e : ((GS0.{u} False μ).vertex Finset.univ).carrier ≃[tinyAEC.{u}.τ]
      ((GS0.{u} True ν).vertex Finset.univ).carrier) : False :=
  (e.symm (⟨PUnit.unit, trivial⟩ : {_x : PUnit.{u + 1} // True})).2

/-- Theorem 12.2 for arbitrary geometric systems is false. -/
theorem theorem_12_2_arbitrary_false :
    ¬ ∀ (K : AbstractElementaryClass.{u}) {n : ℕ} {L : Set (Finset (Fin n))}
      (X Y : GeometricSystem K n L) (h : PrescribedBoundaryIso K X Y),
      ∃ e : (X.vertex Finset.univ).carrier ≃[K.τ] (Y.vertex Finset.univ).carrier,
        K.Strong e.toEmbedding ∧
        ∀ (s : Finset (Fin n)) (hs : s ≠ Finset.univ) (x : (X.vertex s).carrier),
          e (X.le (Finset.subset_univ s) x) = Y.le (Finset.subset_univ s) ((h.onFace s hs) x) := by
  intro H
  obtain ⟨e, -⟩ := H tinyAEC.{u} (GS0 False 0) (GS0 True 0) (pbi0 _ _)
  exact no_top_iso 0 0 e

/-- Theorem 14.3 for arbitrary geometric systems is false (even with the assignment matching
the piece ranks). -/
theorem theorem_14_3_arbitrary_false :
    ¬ ∀ (K : AbstractElementaryClass.{u}) {n : ℕ} {L : Set (Finset (Fin n))} (γ : Cardinal.{u})
      (A : CardinalAssignment n L γ) (X Y : GeometricSystem K n L)
      (h : PrescribedBoundaryIso K X Y),
      ∃ e : (X.vertex Finset.univ).carrier ≃[K.τ] (Y.vertex Finset.univ).carrier,
        K.Strong e.toEmbedding := by
  intro H
  obtain ⟨e, -⟩ := H tinyAEC.{u} (L := L0) 0 ⟨fun _ => 0, fun _ _ => le_rfl, fun _ _ _ _ _ => le_rfl⟩
    (GS0 False 0) (GS0 True 0) (pbi0 _ _)
  exact no_top_iso 0 0 e

/-- Theorem 11.9 for arbitrary geometric systems is false at every threshold. -/
theorem theorem_11_9_arbitrary_false :
    ¬ ∀ (K : AbstractElementaryClass.{u}) {n : ℕ} {L : Set (Finset (Fin n))}
      (hL : Admissible n L),
      ∃ μ0 : Cardinal.{u}, ∀ μ, μ0 ≤ μ →
        ∀ X Y : GeometricSystem K n L, X.level = μ → Y.level = μ →
          (∀ s (hs : s ∈ L), ∃ e : X.piece s hs ≃ Y.piece s hs, True) →
          ∃ f : GeometricArrow K X Y, ∀ t, Function.Bijective (f.onVertex t) := by
  intro H
  obtain ⟨μ0, hμ0⟩ := H tinyAEC.{u} (L := L0) Admissible.nil
  obtain ⟨f, hf⟩ := hμ0 μ0 le_rfl (GS0 False μ0) (GS0 True μ0) rfl rfl
    (fun s hs => ⟨⟨fun x => x.2.elim, fun x => x.2.elim, fun x => x.2.elim, fun x => x.2.elim⟩, trivial⟩)
  obtain ⟨x, -⟩ := (hf ∅).2 (⟨PUnit.unit, trivial⟩ : {_x : PUnit.{u + 1} // True})
  exact x.2

/-- Proposition 11.6 without hypotheses is false: the empty AEC has no geometric system. -/
theorem proposition_11_6_unconditional_false :
    ¬ ∀ (K : AbstractElementaryClass.{u}) {n : ℕ} {L : Set (Finset (Fin n))}
      (hL : Admissible n L) (μ : Cardinal.{u}) (hμ : aleph0 ≤ μ),
      ∃ X : GeometricSystem K n L, X.level = μ ∧ ∀ s (hs : s ∈ L), #(X.piece s hs) = μ := by
  intro H
  obtain ⟨X, -⟩ := H emptyAEC.{u} Admissible.nil ℵ₀ le_rfl
  exact X.inK ∅

/-- A geometric system on `0` axes with one model (a point iff `b`), a chosen piece and a chosen
independence predicate. -/
noncomputable def GSx (b : Prop) (pc : Set {_x : PUnit.{u + 1} // b})
    (ind : Set {_x : PUnit.{u + 1} // b} → Prop) (μ : Cardinal.{u}) :
    GeometricSystem tinyAEC.{u} 0 L0 where
  admissible := Admissible.nil
  level := μ
  vertex _ := ⟨{_x : PUnit.{u + 1} // b}, eStr _⟩
  inK _ := (⟨fun _ _ => Subtype.ext (Subsingleton.elim _ _)⟩ : Subsingleton {_x : PUnit.{u + 1} // b})
  le _ := @emb _ _ (eStr _) (eStr _) id Function.injective_id
  le_strong _ := ⟨⟨fun _ _ => Subtype.ext (Subsingleton.elim _ _)⟩,
    ⟨fun _ _ => Subtype.ext (Subsingleton.elim _ _)⟩⟩
  le_refl _ := rfl
  le_trans _ _ := rfl
  indep _ := ind
  inP t := {x | InClosure ind
    {y | ∃ s, ∃ hs : s ∈ L0, ∃ hst : s ⊆ t, ∃ z, z ∈ pc ∧ id z = y} x}
  piece _ _ := pc
  pieceRank _ hs := #pc
  piece_card _ _ := rfl
  span _ := rfl

/-- The arrow out of the empty system. -/
noncomputable def arrowFromEmpty (ind : Set {_x : PUnit.{u + 1} // True} → Prop)
    (hind : ind ∅) (pc : Set {_x : PUnit.{u + 1} // True}) (μ : Cardinal.{u}) :
    GeometricArrow tinyAEC.{u} (GSx False ∅ (fun _ => True) μ) (GSx True pc ind μ) where
  onVertex _ := @emb _ _ (eStr _) (eStr _) (fun x => x.2.elim) (fun x => x.2.elim)
  onVertex_strong _ := ⟨⟨fun x => x.2.elim⟩, ⟨fun _ _ => Subtype.ext (Subsingleton.elim _ _)⟩⟩
  comm _ := Language.Embedding.ext fun x => x.2.elim
  extends_piece _ _ := by
    rintro _ ⟨x, hx, -⟩
    exact hx.elim
  indep_image _ S := by
    have hS : S = ∅ := Set.eq_empty_of_forall_notMem fun x => x.2.elim
    subst hS
    simp only [Set.image_empty]
    exact ⟨fun _ => hind, fun _ => trivial⟩

/-- Claim 11.10 for arbitrary geometric systems is false: independence is unconstrained, so a
fresh point can be independent in one extension and dependent in another. -/
theorem claim_11_10_arbitrary_false :
    ¬ ∀ (K : AbstractElementaryClass.{u}) {n : ℕ} {L : Set (Finset (Fin n))},
      ∃ μ0 : Cardinal.{u}, ∀ μ, μ0 ≤ μ →
        ∀ (X Y0 Y1 : GeometricSystem K n L),
          X.level = μ → Y0.level = μ → Y1.level = μ →
          ∀ (f0 : GeometricArrow K X Y0) (f1 : GeometricArrow K X Y1) (k : ℕ)
            (labs : Fin k → Finset (Fin n)) (hlabs : ∀ i, labs i ∈ L)
            (b0 : ∀ i, (Y0.vertex (labs i)).carrier)
            (b1 : ∀ i, (Y1.vertex (labs i)).carrier),
            JointlyFreshIndexed f0 labs hlabs b0 →
            JointlyFreshIndexed f1 labs hlabs b1 →
            SameGeometricType f0 f1 labs b0 b1 := by
  intro H
  obtain ⟨μ0, hμ0⟩ := H tinyAEC.{u} (n := 0) (L := L0)
  let pt : {_x : PUnit.{u + 1} // True} := ⟨PUnit.unit, trivial⟩
  have hfresh : ∀ (ind : Set {_x : PUnit.{u + 1} // True} → Prop) (hind : ind ∅),
      JointlyFreshIndexed (arrowFromEmpty ind hind Set.univ μ0) (fun _ : Fin 1 => ∅)
        (fun _ => rfl) (fun _ => pt) := fun ind hind =>
    ⟨fun _ _ => Set.univ, fun _ _ => by
        rw [Set.disjoint_iff]; rintro _ ⟨⟨x, hx, -⟩, -⟩; exact hx.elim,
      fun _ _ => by
        ext y; simp only [Set.mem_union, Set.mem_univ, or_true]; exact ⟨fun _ => trivial, fun _ => trivial⟩,
      fun _ => trivial⟩
  obtain ⟨Z, g0, g1, -, hb⟩ := hμ0 μ0 le_rfl (GSx False ∅ (fun _ => True) μ0)
    (GSx True Set.univ (fun _ => True) μ0) (GSx True Set.univ (fun S => S = ∅) μ0) rfl rfl rfl
    (arrowFromEmpty _ trivial Set.univ μ0) (arrowFromEmpty (fun S => S = ∅) rfl Set.univ μ0) 1
    (fun _ => ∅) (fun _ => rfl) (fun _ => pt) (fun _ => pt)
    (hfresh _ trivial) (hfresh (fun S => S = ∅) rfl)
  have h0 := (g0.indep_image ∅ {pt}).mp trivial
  have h1 := (g1.indep_image ∅ {pt}).mpr
  have heq : g0.onVertex ∅ '' {pt} = g1.onVertex ∅ '' {pt} := by
    have hb0 := hb 0
    have hss : ∀ a b : {_x : PUnit.{u + 1} // True}, a = b :=
      fun a b => Subtype.ext (Subsingleton.elim _ _)
    ext z
    constructor
    · rintro ⟨w, hw, rfl⟩
      exact ⟨w, hw, (congrArg _ (hss w pt)).trans
        (hb0.symm.trans (congrArg _ (hss pt w)))⟩
    · rintro ⟨w, hw, rfl⟩
      exact ⟨w, hw, (congrArg _ (hss w pt)).trans
        (hb0.trans (congrArg _ (hss pt w)))⟩
  exact Set.singleton_ne_empty pt (h1 (heq ▸ h0))

/-- The identity arrow of the empty `GSx` system. -/
noncomputable def idEmptyArrow (μ : Cardinal.{u}) :
    GeometricArrow tinyAEC.{u} (GSx False ∅ (fun _ => True) μ) (GSx False ∅ (fun _ => True) μ) where
  onVertex _ := @emb _ _ (eStr _) (eStr _) id Function.injective_id
  onVertex_strong _ := ⟨⟨fun x => x.2.elim⟩, ⟨fun x => x.2.elim⟩⟩
  comm _ := Language.Embedding.ext fun x => x.2.elim
  extends_piece _ _ := by
    rintro _ ⟨x, hx, -⟩
    exact hx.elim
  indep_image _ _ := ⟨fun _ => trivial, fun _ => trivial⟩

/-- A constant template on the one-vertex edgeless shape (empty model). -/
noncomputable def emptyTemplate : TermTemplate tinyAEC.{u} (SystemShape.discrete PUnit.{u + 1}) :=
  TermTemplate.const (SystemObject.constDiscrete PUnit.{u + 1} ⟨PEmpty.{u + 1}, eStr _⟩
    (⟨fun x => x.elim⟩ : Subsingleton PEmpty.{u + 1}))

/-- **Claim 11.13 is false as formalized without the presentation clause of Definition 5.2(2)**
(i.e. for `IsWorkingPackageCore`; the emptied scheme is not a package under `IsWorkingPackage`). Its second half (the extension property of `U`) is
about arbitrary geometric systems and holds no matter what the scheme is. With the object-free
scheme the first half is vacuous, and an extension `∅ → pt` with no complementary pieces
(so the empty list enumerates them) does not embed over `∅` into `∅`. -/
theorem claim_11_13_false :
    ¬ ∀ (K : AbstractElementaryClass.{u}) (S : SystemShape.{u})
    (W : WorkingScheme K S) (hpack : IsWorkingPackageCore W) {n : ℕ}
    {L : Set (Finset (Fin n))},
    ∃ T, ∃ hT : Tail W.eligible T,
      ∀ μ (hμ : μ ∈ T) (Xg Ug : GeometricSystem K n L) (f : GeometricArrow K Xg Ug)
        {ι : Type u} (label : ι → Finset (Fin n)) (active : ∀ i, label i ∈ L)
        (b : ∀ i, (Ug.vertex (label i)).carrier),
        Xg.level = μ → Ug.level = μ → #ι < μ →
        EnumeratesComplements f label active b →
        (∀ (Xs Us : W.Object μ (Tail.mem hT hμ))
          (sf : SystemArrow K S (W.asSystem _ Xs) (W.asSystem _ Us))
          (hsf : W.permitted (X := Xs) (Y := Us) sf)
          (FX : SchemeFace W (Tail.mem hT hμ) Xs Xg)
          (FU : SchemeFace W (Tail.mem hT hμ) Us Ug),
          SchemeFacesAgree f sf FX FU →
          AllDominated sf hsf ι (fun i =>
            FU.toOccurrence (⟨label i, active i, b i⟩ : Coordinate Ug))) ∧
        ∀ (Yg : GeometricSystem K n L) (g : GeometricArrow K Xg Yg)
          (c : ∀ i, (Yg.vertex (label i)).carrier),
          Yg.level = μ →
          JointlyFreshIndexed g label active c →
          ∃ h : GeometricArrow K Ug Yg,
            FactorsThrough g f h ∧ ∀ i, h.onVertex (label i) (b i) = c i  := by
  intro H
  obtain ⟨T, hT, hmain⟩ := H tinyAEC.{u} (SystemShape.discrete PUnit.{u + 1})
    (WorkingScheme.emptied emptyTemplate Set.univ (fun κ => ⟨κ, le_rfl, trivial⟩))
    (WorkingScheme.emptied_isWorkingPackageCore _ _ _) (n := 0) (L := L0)
  obtain ⟨μ, hμ1, hμT⟩ := hT.2 1
  have hι : #PEmpty.{u + 1} < μ := by
    rw [Cardinal.mk_eq_zero]
    exact lt_of_lt_of_le zero_lt_one hμ1
  have henum : EnumeratesComplements (arrowFromEmpty (fun _ => True) trivial ∅ μ)
      (ι := PEmpty.{u + 1}) isEmptyElim isEmptyElim isEmptyElim :=
    ⟨fun _ _ => ∅, fun _ _ => Set.disjoint_empty _,
      fun _ _ => by rw [Set.union_empty]; exact Set.image_empty _,
      fun i => i.elim, fun _ _ _ hx => hx.elim⟩
  obtain ⟨-, h2⟩ := hmain μ hμT (GSx False ∅ (fun _ => True) μ) (GSx True ∅ (fun _ => True) μ)
    (arrowFromEmpty (fun _ => True) trivial ∅ μ) isEmptyElim isEmptyElim isEmptyElim rfl rfl hι
    henum
  have hfresh : JointlyFreshIndexed (idEmptyArrow μ) (ι := PEmpty.{u + 1}) isEmptyElim
      isEmptyElim isEmptyElim :=
    ⟨fun _ _ => ∅, fun _ _ => Set.disjoint_empty _,
      fun _ _ => by rw [Set.union_empty]; exact Set.image_empty _, fun i => i.elim⟩
  obtain ⟨h, -, -⟩ := h2 (GSx False ∅ (fun _ => True) μ) (idEmptyArrow μ) isEmptyElim rfl hfresh
  exact (h.onVertex ∅ ⟨PUnit.unit, trivial⟩).2.elim

end Audit

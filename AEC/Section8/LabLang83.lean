module

public import AEC.Section2.OrderPresentation
public import Mathlib.ModelTheory.Substructures

/-!
# Lemma 8.3: the old template labels as function symbols

"The language of the samples contains the labels of the old template."  For an order
presentation `E`, each label `a` of arity `n` becomes an `n`-ary function symbol; on `E(I)` it
sends the skeleton entries at increasing positions `p` to the realization of `(a, p)` (and any
other tuple to its first entry).  Every element of `E(I)` is a label value on skeleton
elements, so the skeleton generates `E(I)` in the label language.
-/

@[expose] public section

namespace AEC
namespace Lab83

universe u

open FirstOrder FirstOrder.Language

variable {K : AbstractElementaryClass.{u}} (E : OrderPresentation K)

/-- The label language of an order presentation. -/
def labLang : Language.{u, u} where
  Functions n := {a : E.lab // E.arity a = n}
  Relations _ := PEmpty

variable {E} {I : Type u} [LinearOrder I] [Nonempty I]

open Classical in
/-- The interpretation of a label symbol on `E(I)`. -/
noncomputable def labFun {n : ℕ} (a : (labLang E).Functions n) (x : Fin n → (E.obj I).carrier) :
    (E.obj I).carrier :=
  if h : ∃ p : Fin n → I, StrictMono p ∧ ∀ k, E.skeleton (p k) = x k then
    E.realize ⟨a.1, fun k => h.choose (Fin.cast a.2 k),
      fun _ _ hkl => h.choose_spec.1 (show Fin.cast a.2 _ < Fin.cast a.2 _ from hkl)⟩
  else x ⟨0, a.2 ▸ E.arity_pos a.1⟩

/-- The label structure on `E(I)`. -/
@[instance_reducible]
noncomputable def labStr : (labLang E).Structure (E.obj I).carrier where
  funMap := fun a x => labFun a x
  RelMap := fun r => PEmpty.elim r

/-- **Labels realize support terms on the skeleton.** -/
theorem labFun_skeleton (t : SupportTerm E.lab E.arity I) :
    labFun (n := E.arity t.label) ⟨t.label, rfl⟩ (fun k => E.skeleton (t.pos k)) = E.realize t := by
  have h : ∃ p : Fin (E.arity t.label) → I, StrictMono p ∧
      ∀ k, E.skeleton (p k) = E.skeleton (t.pos k) := ⟨t.pos, t.increasing, fun _ => rfl⟩
  unfold labFun
  rw [dif_pos h]
  have hp : h.choose = t.pos := funext fun k => E.skeleton.injective (h.choose_spec.2 k)
  congr 1
  exact SupportTerm.ext_of_label_eq rfl fun k => by simp [hp]

/-- **The skeleton generates `E(I)` in the label language.** -/
theorem exists_label_value (x : (E.obj I).carrier) :
    ∃ (n : ℕ) (a : (labLang E).Functions n) (p : Fin n → I), StrictMono p ∧
      labFun a (fun k => E.skeleton (p k)) = x := by
  obtain ⟨t, rfl⟩ := E.realize_surjective x
  exact ⟨_, ⟨t.label, rfl⟩, t.pos, t.increasing, labFun_skeleton t⟩

/-- **The image of `E(J)` in `E(J⁺)` is generated by the `J`-skeleton.**  Every element of
`E(f)(E(J))` is a label value on skeleton elements at positions in `f(J)`. -/
theorem map_label_value {J Jp : Type u} [LinearOrder J] [Nonempty J] [LinearOrder Jp]
    [Nonempty Jp] (f : J ↪o Jp) (x : (E.obj J).carrier) :
    ∃ (n : ℕ) (a : (labLang E).Functions n) (p : Fin n → J), StrictMono p ∧
      labFun a (fun k => E.skeleton (f (p k))) = E.map f x := by
  obtain ⟨t, rfl⟩ := E.realize_surjective x
  refine ⟨_, ⟨t.label, rfl⟩, t.pos, t.increasing, ?_⟩
  rw [E.realize_map f t]
  exact labFun_skeleton ⟨t.label, f ∘ t.pos, f.strictMono.comp t.increasing⟩

/-- Order embeddings `y ↦ (y, b y)` into `Jp ×ₗ Bool`. -/
def boolEmb {Jp : Type u} [LinearOrder Jp] (b : Jp → Bool) : Jp ↪o Lex (Jp × ULift.{u} Bool) :=
  OrderEmbedding.ofStrictMono (fun y => toLex (y, ULift.up (b y)))
    (fun _ _ hyz => Prod.Lex.lt_iff.mpr (Or.inl hyz))

@[simp] theorem boolEmb_apply {Jp : Type u} [LinearOrder Jp] (b : Jp → Bool) (y : Jp) :
    boolEmb b y = toLex (y, ULift.up (b y)) := rfl

/-- **Skeleton elements in the image of `E(f)` sit at positions in `f`.**  Two order embeddings
into `Jp ×ₗ Bool` agreeing on `f(J)` but separating a position outside it would otherwise
send the skeleton element to two distinct skeleton elements. -/
theorem skeleton_mem_range {J Jp : Type u} [LinearOrder J] [Nonempty J] [LinearOrder Jp]
    [Nonempty Jp] (f : J ↪o Jp) {i : Jp} (h : E.skeleton i ∈ Set.range (E.map f)) :
    i ∈ Set.range f := by
  classical
  by_contra hi
  obtain ⟨x, hx⟩ := h
  let g := boolEmb (Jp := Jp) fun _ => false
  let g' := boolEmb (Jp := Jp) fun y => decide (y ∉ Set.range f)
  have hfg : f.trans g = f.trans g' := by
    ext j
    simp only [RelEmbedding.trans_apply, g, g', boolEmb_apply]
    simp
  have h1 : E.map g (E.skeleton i) = E.map g' (E.skeleton i) := by
    rw [← hx]
    have e1 := congrFun (congrArg (⇑) (E.map_comp f g)) x
    have e2 := congrFun (congrArg (⇑) (E.map_comp f g')) x
    simp only [Language.Embedding.comp_apply] at e1 e2
    rw [← e1, ← e2, hfg]
  rw [E.skeleton_natural, E.skeleton_natural] at h1
  have h2 := E.skeleton.injective h1
  have h3 := congrArg (fun z => (ofLex z).2.down) h2
  have hi' : ∀ x, ¬ f x = i := fun x hx => hi ⟨x, hx⟩
  simp only [g, g', boolEmb_apply, ofLex_toLex] at h3
  simp [hi'] at h3

/-- **The image of `E(f)` is closed under the label symbols.** -/
theorem labFun_mem_range {J Jp : Type u} [LinearOrder J] [Nonempty J] [LinearOrder Jp]
    [Nonempty Jp] (f : J ↪o Jp) {n : ℕ} (a : (labLang E).Functions n)
    (x : Fin n → (E.obj Jp).carrier) (hx : ∀ k, x k ∈ Set.range (E.map f)) :
    labFun a x ∈ Set.range (E.map f) := by
  unfold labFun
  split_ifs with h
  · have hmem : ∀ k, h.choose k ∈ Set.range f := fun k =>
      skeleton_mem_range f (by rw [h.choose_spec.2 k]; exact hx k)
    choose q hq using hmem
    have hqm : StrictMono q := fun k l hkl => by
      have := h.choose_spec.1 hkl
      rw [← hq k, ← hq l] at this
      exact f.lt_iff_lt.mp this
    refine ⟨E.realize ⟨a.1, fun k => q (Fin.cast a.2 k),
      fun _ _ hkl => hqm (show Fin.cast a.2 _ < Fin.cast a.2 _ from hkl)⟩, ?_⟩
    rw [E.realize_map f]
    congr 1
    exact SupportTerm.ext_of_label_eq rfl fun k => by simp [hq]
  · exact hx _

/-- **The `J`-skeleton generates exactly the image of `E(J)`** in the label language on
`E(J⁺)`: the closure of `{skeleton (f j)}` under the label symbols is `range E(f)`. -/
theorem closure_skeleton_eq {J Jp : Type u} [LinearOrder J] [Nonempty J] [LinearOrder Jp]
    [Nonempty Jp] (f : J ↪o Jp) :
    ((@Substructure.closure (labLang E) (E.obj Jp).carrier labStr
      (Set.range fun j => E.skeleton (f j)) : @Substructure (labLang E) _ labStr) :
        Set (E.obj Jp).carrier) = Set.range (E.map f) := by
  letI := (labStr : (labLang E).Structure (E.obj Jp).carrier)
  apply le_antisymm
  · let S : (labLang E).Substructure (E.obj Jp).carrier :=
      { carrier := Set.range (E.map f)
        fun_mem := fun a x hx => labFun_mem_range f a x hx }
    have : Set.range (fun j => E.skeleton (f j)) ⊆ (S : Set _) := by
      rintro _ ⟨j, rfl⟩
      exact ⟨E.skeleton j, E.skeleton_natural f j⟩
    exact Substructure.closure_le.mpr this
  · rintro _ ⟨x, rfl⟩
    obtain ⟨n, a, p, -, hp⟩ := map_label_value (E := E) f x
    rw [← hp]
    exact Substructure.fun_mem _ a _ fun k => Substructure.subset_closure ⟨p k, rfl⟩

section Transport

variable {N : Type u} (e : (E.obj I).carrier → N)

open Classical in
/-- **Transported labels** (for the `Y`-sort, `Y ≅ F(Z)` inside `L`): labels act through an
injection `e : E(I) → N` on tuples from its range, and return the first entry otherwise. -/
noncomputable def labT {n : ℕ} (a : (labLang E).Functions n) (x : Fin n → N) : N :=
  if h : ∀ k, ∃ y, e y = x k then e (labFun a fun k => (h k).choose)
  else x ⟨0, a.2 ▸ E.arity_pos a.1⟩

/-- The range of `e` is closed under the transported labels. -/
theorem labT_mem_range {n : ℕ} (a : (labLang E).Functions n) (x : Fin n → N)
    (hx : ∀ k, x k ∈ Set.range e) : labT e a x ∈ Set.range e := by
  unfold labT
  split_ifs with h
  · exact ⟨_, rfl⟩
  · exact hx _

/-- The transported labels realize `e` of support terms on the transported skeleton, so the
transported skeleton generates `range e`. -/
theorem labT_skeleton (he : Function.Injective e) (t : SupportTerm E.lab E.arity I) :
    labT e (n := E.arity t.label) ⟨t.label, rfl⟩ (fun k => e (E.skeleton (t.pos k))) =
      e (E.realize t) := by
  have h : ∀ k, ∃ y, e y = e (E.skeleton (t.pos k)) := fun k => ⟨_, rfl⟩
  unfold labT
  rw [dif_pos h]
  have hc : (fun k => (h k).choose) = fun k => E.skeleton (t.pos k) :=
    funext fun k => he (h k).choose_spec
  rw [hc, labFun_skeleton]

/-- **Sub-presentation images are closed under transported labels**: for an order embedding
`f : J ↪o I`, the set `e(E(f)(E(J)))` (e.g. `X ≅ F(J)` inside `Y ≅ F(Z)`) is closed under the
labels transported along an injective `e`. -/
theorem labT_mem_range_map (he : Function.Injective e) {J : Type u} [LinearOrder J] [Nonempty J]
    (f : J ↪o I) {n : ℕ} (a : (labLang E).Functions n) (x : Fin n → N)
    (hx : ∀ k, x k ∈ Set.range (e ∘ E.map f)) : labT e a x ∈ Set.range (e ∘ E.map f) := by
  unfold labT
  split_ifs with h
  · have hy : ∀ k, (h k).choose ∈ Set.range (E.map f) := fun k => by
      obtain ⟨z, hz⟩ := hx k
      exact ⟨z, he (hz.trans (h k).choose_spec.symm)⟩
    obtain ⟨w, hw⟩ := labFun_mem_range f a _ hy
    exact ⟨w, by simp only [Function.comp_apply, hw]⟩
  · exact hx _

/-- The transported-label structure. -/
@[instance_reducible]
noncomputable def labTStr : (labLang E).Structure N where
  funMap := fun a x => labT e a x
  RelMap := fun r => PEmpty.elim r

end Transport

section Restricted

open Classical in
/-- **Labels restricted to a set `R`** (the `X`-sort copy): act as the labels on tuples from
`R`, and return the first entry otherwise. -/
noncomputable def labR (R : Set (E.obj I).carrier) {n : ℕ} (a : (labLang E).Functions n)
    (x : Fin n → (E.obj I).carrier) : (E.obj I).carrier :=
  if ∀ k, x k ∈ R then labFun a x else x ⟨0, a.2 ▸ E.arity_pos a.1⟩

/-- The restricted-label structure. -/
@[instance_reducible]
noncomputable def labRStr (R : Set (E.obj I).carrier) : (labLang E).Structure (E.obj I).carrier where
  funMap := fun a x => labR R a x
  RelMap := fun r => PEmpty.elim r

/-- A set containing a label-closed `R` is closed under the labels restricted to `R`. -/
theorem labR_mem {R S : Set (E.obj I).carrier}
    (hR : ∀ {n} (a : (labLang E).Functions n) (x : Fin n → (E.obj I).carrier),
      (∀ k, x k ∈ R) → labFun a x ∈ R) (hRS : R ⊆ S)
    {n : ℕ} (a : (labLang E).Functions n) (x : Fin n → (E.obj I).carrier) (hx : ∀ k, x k ∈ S) :
    labR R a x ∈ S := by
  unfold labR
  split_ifs with h
  · exact hRS (hR a x h)
  · exact hx _

theorem labR_of_mem {R : Set (E.obj I).carrier} {n : ℕ} (a : (labLang E).Functions n)
    (x : Fin n → (E.obj I).carrier) (hx : ∀ k, x k ∈ R) : labR R a x = labFun a x := by
  unfold labR
  rw [if_pos hx]

end Restricted

end Lab83
end AEC

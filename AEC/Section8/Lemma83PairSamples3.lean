module

public import AEC.Section8.Lemma83PairSamples

@[expose] public section

/-!
# Lemma 8.3 for the Prop 5.6 scheme: samples in the three-copy pair language

From the two-copy samples, add the `Y`-sort labels transported along an iso `ι : F(J) ≅ Y`
(composed with `F : Y → L`): `Y` is closed under the `pairLang2` functions, and the transported
labels on the `ι`-image of the `J`-skeleton realize `F ∘ ι` of the support terms (`Y ≅ F(Z)`
with `Z := J`, generated by its chart).  The third copy is the full labels on `L`.
-/

universe u

open Cardinal FirstOrder

namespace AEC

variable {K : AbstractElementaryClass.{u}}

/-- **Three-copy pair samples.** -/
theorem infra_83_pair3_samples (P : SingleModelData K)
    (Pr : StationaryPrescription K oneVertexShape P.scheme) {κ : Cardinal.{u}} (hκ : ℵ₀ ≤ κ)
    (θ : Cardinal.{u}) :
    ∃ μ : Cardinal.{u}, θ ≤ μ ∧ κ < μ ∧
    ∃ (J : Type u) (_ : LinearOrder J) (_ : Nonempty J), OrderSat83.OrderSaturated κ J ∧ #J = μ ∧
    ∃ M : MarkedPair K oneVertexShape P.scheme Pr, M.μ = μ ∧
      ∃ eX : Language.Embedding K.τ (P.E.obj J).carrier
          ((P.scheme.asSystem M.hμ M.X).obj PUnit.unit).carrier,
        Function.Bijective eX ∧ K.Strong eX ∧
      ∃ ι : (P.E.obj J).carrier ≃[K.τ] ((P.scheme.asSystem M.hμ M.Y).obj PUnit.unit).carrier,
      ∃ (Jplus : Type u) (_ : LinearOrder Jplus) (_ : Nonempty Jplus) (emb : J ↪o Jplus)
        (strip : Set Jplus), #strip = μ ∧ IsConvexRegion strip ∧
      ∃ (F : Language.Embedding K.τ ((P.scheme.asSystem M.hμ M.Y).obj PUnit.unit).carrier
          (P.E.obj Jplus).carrier),
        K.Strong F ∧ (∀ x, F (M.incl.onVertex PUnit.unit (eX x)) = P.E.map emb x) ∧
      ∃ s₀ : (LS83.pairLang P.E).Structure (P.E.obj Jplus).carrier,
        @LS83.LSClosed K _ (@Language.LHom.reduct _ _ (LS83.pairInl P.E) _ s₀) ∧
        @Language.LHom.reduct _ _ ((LS83.pairInl P.E).comp (LS83.lsInl K)) _ s₀ =
          (P.E.obj Jplus).str ∧
        (∀ {n} (f : (LS83.pairLang P.E).Functions n) (x : Fin n → (P.E.obj Jplus).carrier),
          (∀ i, x i ∈ Set.range (P.E.map emb)) →
            @Language.Structure.funMap _ _ s₀ n f x ∈ Set.range (P.E.map emb)) ∧
        (∀ x : (P.E.obj J).carrier, ∃ (n : ℕ) (a : (Lab83.labLang P.E).Functions n)
          (p : Fin n → J), StrictMono p ∧
          @Language.Structure.funMap _ _ s₀ n (Sum.inr a) (fun k => P.E.skeleton (emb (p k))) =
            P.E.map emb x) ∧
        (∀ {n} (f : (LS83.pairLang2 P.E).Functions n) (x : Fin n → (P.E.obj Jplus).carrier),
          (∀ i, x i ∈ Set.range F) →
            @Language.Structure.funMap _ _
              (@Language.sumStructure _ _ _ s₀ (Lab83.labTStr (fun y => F (ι y)))) n f x ∈
              Set.range F) ∧
        (∀ t : SupportTerm P.E.lab P.E.arity J,
          @Language.Structure.funMap _ _
            (@Language.sumStructure _ _ _ s₀ (Lab83.labTStr (fun y => F (ι y)))) _
            (Sum.inr ⟨t.label, rfl⟩) (fun k => F (ι (P.E.skeleton (t.pos k)))) =
            F (ι (P.E.realize t))) ∧
        (∀ t : SupportTerm P.E.lab P.E.arity Jplus,
          @Language.Structure.funMap _ _ (@Language.sumStructure _ _ _
            (@Language.sumStructure _ _ _ s₀ (Lab83.labTStr (fun y => F (ι y)))) Lab83.labStr) _
            (Sum.inr ⟨t.label, rfl⟩) (fun k => P.E.skeleton (t.pos k)) = P.E.realize t) ∧
        (∀ {n} (a : (Lab83.labLang P.E).Functions n) (x : Fin n → (P.E.obj Jplus).carrier),
          @Language.Structure.funMap _ _ s₀ n (Sum.inr a) x =
            Lab83.labR (Set.range (P.E.map emb)) a x) := by
  classical
  obtain ⟨μ, h1, h2, J, i1, i2, h4, hJ, M, h8, eX, h9, sX, hZ, Jplus, i3, i4, emb, strip, hs, hc,
    F, sF, hF, s₀, hcl, hred, hX, hY, hlab, hfull, hlabR, -⟩ := infra_83_pair2_samples P Pr hκ θ
  obtain ⟨ι⟩ := hZ J hJ
  have hinj : Function.Injective (fun y => F (ι y)) := F.injective.comp ι.injective
  refine ⟨μ, h1, h2, J, i1, i2, h4, hJ, M, h8, eX, h9, sX, ι, Jplus, i3, i4, emb, strip, hs, hc,
    F, sF, hF, s₀, hcl, hred, hX, hlab, ?_, fun t => ?_, fun t => hfull t, hlabR⟩
  · intro n f x hx
    rcases f with f | a
    · exact hY f x hx
    · have hx' : ∀ k, x k ∈ Set.range (fun y => F (ι y)) := fun k => by
        obtain ⟨y, hy⟩ := hx k
        exact ⟨ι.symm y, by simp [hy]⟩
      obtain ⟨w, hw⟩ := Lab83.labT_mem_range (fun y => F (ι y)) a x hx'
      exact ⟨ι w, hw⟩
  · exact Lab83.labT_skeleton (fun y => F (ι y)) hinj t

end AEC

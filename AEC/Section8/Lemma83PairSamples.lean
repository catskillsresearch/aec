module

public import AEC.Section8.Lemma83RetSamples
public import AEC.Section8.PairLang83

@[expose] public section

/-!
# Lemma 8.3 for the Prop 5.6 scheme: samples in the pair language

The retraction-expanded samples `L = F(J⁺)` further expanded by the old template labels of
`F = P.E`.  The pair-language reduct to the LS language is LS-closed, and `X = range F(emb)` is
closed under every pair-language function and generated by the `J`-skeleton.
-/

universe u

open Cardinal FirstOrder

namespace AEC

variable {K : AbstractElementaryClass.{u}}

/-- **Pair-language samples with `X` closed and generated by the `J`-skeleton.** -/
theorem infra_83_pair_samples_X (P : SingleModelData K)
    (Pr : StationaryPrescription K oneVertexShape P.scheme) {κ : Cardinal.{u}} (hκ : ℵ₀ ≤ κ)
    (θ : Cardinal.{u}) :
    ∃ μ : Cardinal.{u}, θ ≤ μ ∧ κ < μ ∧
    ∃ (J : Type u) (_ : LinearOrder J) (_ : Nonempty J), OrderSat83.OrderSaturated κ J ∧ #J = μ ∧
    ∃ (Jplus : Type u) (_ : LinearOrder Jplus) (_ : Nonempty Jplus) (emb : J ↪o Jplus)
      (str : (LS83.pairLang P.E).Structure (P.E.obj Jplus).carrier),
      @LS83.LSClosed K _ (@Language.LHom.reduct _ _ (LS83.pairInl P.E) _ str) ∧
      @Language.LHom.reduct _ _ ((LS83.pairInl P.E).comp (LS83.lsInl K)) _ str =
        (P.E.obj Jplus).str ∧
      (∀ {n} (f : (LS83.pairLang P.E).Functions n) (x : Fin n → (P.E.obj Jplus).carrier),
        (∀ i, x i ∈ Set.range (P.E.map emb)) →
          @Language.Structure.funMap _ _ str n f x ∈ Set.range (P.E.map emb)) ∧
      (∀ x : (P.E.obj J).carrier, ∃ (n : ℕ) (a : (Lab83.labLang P.E).Functions n)
        (p : Fin n → J), StrictMono p ∧
        @Language.Structure.funMap _ _ str n (Sum.inr a) (fun k => P.E.skeleton (emb (p k))) =
          P.E.map emb x) := by
  obtain ⟨μ, h1, h2, J, i1, i2, h4, hJ, M, -, eX, -, -, -, Jplus, i3, i4, emb, -, -, -,
    F, -, -, R, code, str, g, -, hcl, hred, hX, -, -⟩ := infra_83_ret_samples P Pr hκ θ
  let s : (LS83.pairLang P.E).Structure (P.E.obj Jplus).carrier :=
    @Language.sumStructure _ _ _ (LS83.retExp str g) Lab83.labStr
  refine ⟨μ, h1, h2, J, i1, i2, h4, hJ, Jplus, i3, i4, emb, s, hcl, hred,
    fun f x hx => LS83.pair_closed P.E _ _ (fun f x hx => hX f x hx)
      (fun f x hx => Lab83.labFun_mem_range emb f x hx) f x hx, fun x => ?_⟩
  exact Lab83.map_label_value emb x
